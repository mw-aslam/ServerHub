# Project URL из Supabase: Project Settings → Data API
SUPABASE_URL=https://your-project-ref.supabase.co

# Секретный ключ из Supabase: Project Settings → API Keys
# Подходит новый ключ sb_secret_... или старый service_role.
SUPABASE_SERVICE_KEY=

# Пароль для входа на сайт, не короче 12 символов
ADMIN_PASSWORD=

# Длинная случайная строка, не короче 32 символов
SESSION_SECRET=
