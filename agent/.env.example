# Адрес сайта на Vercel, без слэша в конце
BACKEND_URL=https://your-project.vercel.app

# Оба значения показываются один раз при нажатии «Добавить сервер» на сайте
SERVER_ID=
AGENT_KEY=

# Как часто отправлять метрики и забирать команды, в секундах (от 3 до 25).
# 10 секунд — примерно 259 тысяч запросов к Vercel в месяц на один сервер.
SYNC_INTERVAL_SEC=10

# Как часто обновлять тяжёлые данные, в секундах
PM2_INTERVAL_SEC=15
BATTERY_INTERVAL_SEC=30
DISK_INTERVAL_SEC=60
WIFI_INTERVAL_SEC=60

# Имя агента в pm2. Менять вместе с ecosystem.config.js
AGENT_PM2_NAME=serverhub-agent

# Только для Windows, если pm2 установлен не в %APPDATA%\npm:
# полный путь к файлу node_modules\pm2\bin\pm2
# PM2_SCRIPT=
